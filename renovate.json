{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "description": "Renovate configuration for Crebit Studio (Vivid)",
  "timezone": "Asia/Seoul",
  "schedule": ["after 9am and before 5pm on weekdays"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Major updates require manual review",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "Group backend Python dependencies",
      "matchPaths": ["backend/requirements*.txt"],
      "groupName": "backend dependencies",
      "groupSlug": "backend"
    },
    {
      "description": "Group frontend Node.js dependencies",
      "matchPaths": ["frontend/package.json"],
      "groupName": "frontend dependencies",
      "groupSlug": "frontend"
    },
    {
      "description": "Security updates get high priority",
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["patch"],
      "matchDepTypes": ["dependencies"],
      "vulnerabilityAlerts": true,
      "labels": ["dependencies", "security"]
    },
    {
      "description": "Pin GitHub Actions to SHA for security",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Update Docker images weekly",
      "matchManagers": ["dockerfile"],
      "schedule": ["on monday"],
      "groupName": "docker images"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "priority-high"]
  },
  "pip_requirements": {
    "fileMatch": ["backend/requirements.*\\.txt$"]
  }
}
