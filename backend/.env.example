# Crebit Node Canvas - Backend Environment
# Copy to .env and fill in your values

# =============================================================================
# Core Settings
# =============================================================================
ENVIRONMENT=development
PROJECT_NAME=Crebit Node Canvas
LOG_LEVEL=INFO
GRAPHQL_ENABLED=false

# =============================================================================
# PostgreSQL Database
# =============================================================================
POSTGRES_USER=crebit_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=crebit_canvas
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6380

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
CORS_PRODUCTION_ORIGINS=https://crebit.app,https://www.crebit.app,https://api.crebit.app
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=600

# =============================================================================
# Google OAuth
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_SCOPES=openid email profile
# Advanced (usually no need to change):
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_TOKEN_INFO_URL=https://oauth2.googleapis.com/tokeninfo

# =============================================================================
# Session & Auth
# =============================================================================
SESSION_SECRET=change_me_to_random_string
SESSION_TTL_SECONDS=604800
OAUTH_STATE_TTL_SECONDS=600
SESSION_COOKIE_NAME=crebit_session
OAUTH_STATE_COOKIE_NAME=crebit_oauth_state
AUTH_SUCCESS_REDIRECT=http://localhost:3100
AUTH_ERROR_REDIRECT=http://localhost:3100/login?error=auth_failed
MASTER_ADMIN_EMAILS=admin@example.com

# =============================================================================
# Original-IP Foundry (A-Prime)
# =============================================================================
AD_FOUNDRY_ENABLED=false
AD_FOUNDRY_WRITE_ENABLED=false
AD_FOUNDRY_ACCESS_SCOPE=internal
AD_FOUNDRY_ALLOWLIST=admin@example.com
AD_FOUNDRY_WORKER_PROVIDER=agent0
AD_FOUNDRY_TASKIQ_BROKER=redis://localhost:6379
# Read-only 기간에도 허용할 non-destructive POST endpoint
AD_FOUNDRY_READONLY_SAFE_PATHS=/api/v1/foundry/rights/evaluate-assets,/api/v1/foundry/patterns/extract,/api/v1/foundry/recommendations/next-scene,/api/v1/foundry/experiments/assign,/api/v1/foundry/experiments/feedback,/api/v1/foundry/memory/normalize,/api/v1/foundry/retrieval/query,/api/v1/foundry/provenance/export-c2pa,/api/v1/foundry/workers/dispatch,/api/v1/foundry/workers/jobs

# =============================================================================
# Gemini API (Required for AI features)
# =============================================================================
GEMINI_API_KEY=
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_VIDEO_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3-flash-preview
# Agent settings:
GEMINI_AGENT_MODEL=gemini-3-flash-preview
GEMINI_AGENT_TEMPERATURE=0.4
GEMINI_AGENT_MAX_TOKENS=2048
GEMINI_AGENT_MODELS=gemini-3-flash,gemini-3-flash-preview,gemini-3-pro,gemini-3-pro-preview

# =============================================================================
# Tavily API (Web Search - Optional)
# Get free key at https://tavily.com (1,000 credits/month)
# =============================================================================
TAVILY_API_KEY=

# =============================================================================
# Qdrant Vector Database (Optional)
# =============================================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# =============================================================================
# NICE Payments (나이스페이)
# Sandbox credentials for testing - replace with production keys
# =============================================================================
NICEPAY_CLIENT_ID=
NICEPAY_SECRET_KEY=
NICEPAY_API_URL=https://sandbox-api.nicepay.co.kr
NICEPAY_MODE=sandbox

# =============================================================================
# NotebookLM Enterprise API (Optional)
# =============================================================================
NOTEBOOKLM_PROJECT_NUMBER=
NOTEBOOKLM_LOCATION=global
NOTEBOOKLM_ENDPOINT=global
NOTEBOOKLM_CREDENTIALS_PATH=

# =============================================================================
# Monitoring & Observability
# =============================================================================
# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=

# Prometheus (Metrics)
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics

# =============================================================================
# RAG Configuration (Phase 2)
# =============================================================================
# Router decision logging sink: "db" to enable database persistence
# Leave empty for structured logging only (default)
RAG_ROUTER_LOG_SINK=

# Quality evaluation (disabled by default in CI)
# Set to "1" to enable quality harness tests
RAG_QUALITY_EVAL=

# =============================================================================
# Capsule Execution
# =============================================================================
CAPSULE_EXECUTION_TIMEOUT=120
CAPSULE_SYNC_TIMEOUT=60
CAPSULE_HEAVY_TIMEOUT=300
SEED_AUTEUR_DATA=false
ALLOW_INPUT_FALLBACKS=true

# =============================================================================
# Video Schema Validation
# =============================================================================
VIDEO_SCHEMA_VERSIONS=gemini-video-v1
VIDEO_KEYFRAME_PATTERN=^[A-Za-z0-9][A-Za-z0-9_-]{1,63}$
VIDEO_EVIDENCE_REF_PATTERN=^[a-z][a-z0-9_-]*:.+

# =============================================================================
# Sheets Bus (Legacy - Scripts only)
# =============================================================================
SHEETS_MODE=csv
SHEETS_API_BASE=https://sheets.googleapis.com/v4
SHEETS_SPREADSHEET_ID=
SHEETS_API_KEY=
# CSV URLs (for SHEETS_MODE=csv):
CREBIT_RAW_ASSETS_CSV_URL=
CREBIT_VIDEO_STRUCTURED_CSV_URL=
CREBIT_DERIVED_INSIGHTS_CSV_URL=
CREBIT_PATTERN_CANDIDATES_CSV_URL=
CREBIT_PATTERN_TRACE_CSV_URL=
CREBIT_NOTEBOOK_LIBRARY_CSV_URL=
CREBIT_NOTEBOOK_ASSETS_CSV_URL=
CREBIT_QUARANTINE_CSV_PATH=
# Sheets ranges:
CREBIT_RAW_ASSETS_RANGE=CREBIT_RAW_ASSETS
CREBIT_VIDEO_STRUCTURED_RANGE=CREBIT_VIDEO_STRUCTURED
CREBIT_DERIVED_INSIGHTS_RANGE=CREBIT_DERIVED_INSIGHTS
CREBIT_PATTERN_CANDIDATES_RANGE=CREBIT_PATTERN_CANDIDATES
CREBIT_PATTERN_TRACE_RANGE=CREBIT_PATTERN_TRACE
CREBIT_NOTEBOOK_LIBRARY_RANGE=CREBIT_NOTEBOOK_LIBRARY
CREBIT_NOTEBOOK_ASSETS_RANGE=CREBIT_NOTEBOOK_ASSETS
CREBIT_QUARANTINE_RANGE=CREBIT_QUARANTINE
# Promotion thresholds:
PATTERN_CONFIDENCE_THRESHOLD=0.6
TEMPLATE_REWARD_MIN_EVIDENCE=3
TEMPLATE_REWARD_MAX_CREDITS=120
TEMPLATE_PROMOTION_THRESHOLD=0.75
TEMPLATE_PROMOTION_MIN_SAMPLES=3
AUTO_PROMOTE_TEMPLATES=false
AFFILIATE_REQUIRE_EMAIL_VERIFICATION=true
SHEETS_RETRY_COUNT=3
SHEETS_RETRY_BASE_SECONDS=0.5
