# =============================================================================
# Crebit Node Canvas - Production Environment
# =============================================================================
# 이 파일은 프로덕션 배포 시 사용할 환경변수 템플릿입니다.
# 실제 배포 시 민감한 값들을 채워넣으세요.
# =============================================================================

# Core Settings
ENVIRONMENT=production
PROJECT_NAME=Crebit Node Canvas
LOG_LEVEL=WARNING

# =============================================================================
# PostgreSQL Database (Production)
# =============================================================================
POSTGRES_USER=crebit_user
POSTGRES_PASSWORD=__CHANGE_ME__
POSTGRES_DB=crebit_canvas
POSTGRES_HOST=__PRODUCTION_DB_HOST__
POSTGRES_PORT=5432

# =============================================================================
# Redis (Production)
# =============================================================================
REDIS_URL=redis://__PRODUCTION_REDIS_HOST__:6379

# =============================================================================
# CORS Configuration (Production)
# =============================================================================
CORS_ORIGINS=https://crebit.app,https://www.crebit.app,https://api.crebit.app
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=600

# =============================================================================
# Google OAuth (Production URLs)
# =============================================================================
GOOGLE_CLIENT_ID=__CHANGE_ME__
GOOGLE_CLIENT_SECRET=__CHANGE_ME__
GOOGLE_REDIRECT_URI=https://api.crebit.app/api/v1/auth/google/callback
SESSION_SECRET=__GENERATE_SECURE_SECRET__

# Auth Redirects
AUTH_SUCCESS_REDIRECT=https://crebit.app
AUTH_ERROR_REDIRECT=https://crebit.app/login?error=auth_failed

# =============================================================================
# Gemini API
# =============================================================================
GEMINI_API_KEY=AIzaSyBXXmaB4eRr-MPgyApIgGynxlT6IP5LF3w
GEMINI_ENABLED=true
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_VIDEO_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3-flash-preview
GEMINI_AGENT_MODEL=gemini-3-flash-preview

# =============================================================================
# NICE Payments (Production)
# =============================================================================
NICEPAY_CLIENT_ID=__CHANGE_ME__
NICEPAY_SECRET_KEY=__CHANGE_ME__
NICEPAY_API_URL=https://api.nicepay.co.kr
NICEPAY_MODE=production

# =============================================================================
# Monitoring (Production)
# =============================================================================
SENTRY_DSN=__CHANGE_ME__
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=production

# =============================================================================
# Qdrant Vector Database (Production)
# =============================================================================
QDRANT_URL=__PRODUCTION_QDRANT_URL__
QDRANT_API_KEY=__CHANGE_ME__

# =============================================================================
# Tavily API
# =============================================================================
TAVILY_API_KEY=__CHANGE_ME__
