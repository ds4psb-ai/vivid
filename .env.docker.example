# Docker Environment Variables
# Copy this file to .env.docker and configure for your environment
#
# Security Notes (P0 Hardening):
# - NEVER commit .env.docker with real credentials
# - Use strong, randomly generated passwords
# - For production, consider using Docker Secrets instead

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=crebit_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=crebit_canvas

# =============================================================================
# Redis
# =============================================================================
# Redis password - REQUIRED for production
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=your_secure_redis_password_here

# =============================================================================
# Qdrant (optional - only if using API key)
# =============================================================================
# QDRANT_API_KEY=your_qdrant_api_key_here
