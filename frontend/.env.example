# Vivid Frontend Environment Variables
# Copy this file to .env.local and configure values

# =============================================================================
# Core Configuration
# =============================================================================

# Backend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8100

# Demo user ID (development only)
NEXT_PUBLIC_USER_ID=demo-user

# =============================================================================
# Feature Flags
# =============================================================================

# Flow (Dimension Workflow) - Controls /flow page and related UI
# Default: false (disabled) - Set to "true" when workflow API integration is complete
NEXT_PUBLIC_FLOW_ENABLED=false

# Artifact Preview for Flow/Teaching paths
# Default: false (disabled) - Set to "true" when backend generates artifact_type
NEXT_PUBLIC_ARTIFACT_PREVIEW_ENABLED=false

# B2B API Credits (Wallet)
# Default: false (disabled) - For future B2B wallet implementation
NEXT_PUBLIC_B2B_WALLET_ENABLED=false
